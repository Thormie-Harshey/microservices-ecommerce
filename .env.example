# Postgres (database)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecommerce

# Ports inside the containers
GATEWAY_PORT=3000
PRODUCT_PORT=3001
ORDER_PORT=3002

# Port on your computer that reaches the gateway
HOST_PORT=8080

# How long Redis keeps the product list (seconds)
CACHE_TTL_SECONDS=60

# Images used by docker-compose.prod.yml
DOCKERHUB_USER=thormie
IMAGE_TAG=v1.0.1
